# Shared ingest key. Production refuses to start without it.
SMM_API_KEY=replace-with-a-long-random-value

# Gateway
PORT=8090
DEMO_FEED=true
DEMO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
DEMO_TICK_MS=1000
DEMO_CANDLE_MS=15000
CORS_ORIGIN=
LOG_LEVEL=info

# Engine
SMM_ENGINE_URL=127.0.0.1:50051
SMM_ENGINE_HOST=0.0.0.0
SMM_ENGINE_PORT=50051
SMM_ENGINE_WORKERS=4
SMM_MAX_CANDLES=5000
SMM_MAX_SERIES_POINTS=300
